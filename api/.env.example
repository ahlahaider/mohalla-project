# Copy this file to .env and fill in real values. Never commit .env.

# Connection string from MongoDB Atlas (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mohalla

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# ---- Sign-up codes (OTP) ----
# One setting per channel decides how codes are sent:
#   demo   = nothing is sent; the code is always 1234 and the app shows it on screen
#   twilio = real WhatsApp message through Twilio's WhatsApp sandbox (WhatsApp only)
#   meta   = real WhatsApp message through Meta's WhatsApp Cloud API (WhatsApp only)
# SMS stays "demo" for the course project: real SMS needs a paid service (future work).
OTP_SMS_MODE=demo
OTP_WHATSAPP_MODE=demo

# Needed only when OTP_WHATSAPP_MODE=twilio (see README: "WhatsApp codes")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Needed only when OTP_WHATSAPP_MODE=meta (see README: "WhatsApp codes")
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TEMPLATE=mohalla_code
META_WA_TEMPLATE_LANG=en
