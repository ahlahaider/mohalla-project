{
  "expo": {
    "name": "Mohalla Worker",
    "slug": "mohalla-worker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF3E2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Mohalla Worker"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mohalla uses the camera to take photos of shop bills and your profile picture.",
          "photosPermission": "Mohalla lets you choose a photo of a bill or your profile picture."
        }
      ]
    ],
    "scheme": "mohalla-worker",
    "backgroundColor": "#fbf4ea",
    "primaryColor": "#b5432a"
  }
}
